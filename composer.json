{
    "name": "phongtroqn/phongtroqn",
    "description": "Nen tang tim kiem va dang tin phong tro Quy Nhon (Pure PHP MVC)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/Controllers",
            "app/Models",
            "app/Helpers"
        ],
        "files": [
            "app/Helpers/Env.php",
            "app/Helpers/Auth.php",
            "app/Helpers/Csrf.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}

