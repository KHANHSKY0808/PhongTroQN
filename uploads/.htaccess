# PhongTroQN - uploads/.htaccess
# Ngăn chặn thực thi script và mã thực thi trong thư mục uploads

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|phps|inc|cgi|pl|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Vô hiệu hóa PHP engine nếu mod_php được kích hoạt
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Chặn duyệt danh mục file và chặn thực thi CGI
Options -Indexes -ExecCGI

