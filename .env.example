# Cấu hình môi trường ứng dụng
APP_NAME=PhongTroQN
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/PhongTroQN/public

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phongtroqn
DB_USER=root
DB_PASS=

# Cấu hình Gửi Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=tls
SMTP_FROM_ADDRESS=your_email@gmail.com
SMTP_FROM_NAME=PhongTroQN
